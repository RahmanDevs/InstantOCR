# ==========================================
# InstantOCR Environment Configuration
# ==========================================

# Hugging Face Inference API Configuration
# Buat akun di https://huggingface.co lalu generate token (Settings -> Access Tokens)
HF_API_TOKEN=your_huggingface_api_token_here
HF_KEY=your_huggingface_api_token_here
# Model identifier atau full inference endpoint URL (misal: microsoft/trocr-base-stage1)
HF_MODEL=microsoft/trocr-base-stage1

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-instant-ocr-change-this-in-production-key-99
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# FastAPI Backend Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
